# Supabase Configuration
#
# Local (recommended for day-to-day use — no Vercel, no hosted project):
#   1. Start Docker Desktop
#   2. npm run supabase:start
#   3. Copy API URL / anon / service_role from `npm run supabase:status` into this file
#   4. npm run dev
# Default local values after `supabase start`:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from supabase status>
# SUPABASE_SECRET_KEY=<service_role key from supabase status>
#
# Hosted Supabase (optional):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here

# AI (draft proposals, reply suggestions, schedule extraction). Server-only —
# never expose these to the client. When no key is set, /api/drafts/generate
# falls back to deterministic templates and says so explicitly; it never
# pretends a template is an AI proposal. Check it in Settings > AI連携.
#
# DeepSeek (default) — keys: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional: defaults to deepseek-flash (cheap, fast). deepseek-v4-pro is stronger.
DEEPSEEK_MODEL=
# Optional: only for an OpenAI-compatible proxy. Defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=
# Optional: force a provider ("deepseek" | "anthropic"). Unset = DeepSeek if its
# key is set, otherwise Anthropic if that key is set.
AI_PROVIDER=
# Anthropic (alternative; used only when AI_PROVIDER=anthropic or no DeepSeek key)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-4-5-20251001 when unset.
ANTHROPIC_MODEL=
# Optional: USD per million tokens, used only to estimate ai_generations.cost_usd.
# Token counts are always recorded accurately even when these are left unset (cost stays 0).
# DeepSeek's prices vary by time of day — check https://api-docs.deepseek.com/quick_start/pricing
# (the older ANTHROPIC_*_COST_PER_MTOK names still work as a fallback).
AI_INPUT_COST_PER_MTOK=
AI_OUTPUT_COST_PER_MTOK=

# Publish Worker (PR3). Secures /api/publish/run, invoked on a schedule
# (see vercel.json). Vercel sets the Authorization header from this value
# automatically for its own Cron Jobs — see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
# Without this set, the Worker refuses every request (fails closed).
CRON_SECRET=

# Publishing strategy (build-time, browser-visible). Unset/anything else =
# "zero-cost": approved posts are copied/shared and the human presses the final
# Publish button in each app — no developer app or OAuth connection needed.
# Set to "api-first" only after registering the developer apps below; connected
# platforms then publish automatically at the scheduled time.
# Settings > 連携済みの媒体 shows which mode is active and, for each platform,
# which of the variables below are still missing plus the redirect URI to register.
NEXT_PUBLIC_PUBLISHING_STRATEGY=

# Social connectors (PR4). Server-only — never expose these to the client.
# The public URL this app is deployed at, used to build OAuth redirect_uris.
# Must exactly match what's registered in the X/Meta developer console.
# Falls back to the request's own origin if unset (fine for local dev).
NEXT_PUBLIC_APP_URL=

# Encrypts OAuth tokens before they are stored (AES-256-GCM). Required to
# connect any social account. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=

# X (Twitter) OAuth 2.0 app — https://developer.x.com
# Redirect URI to register: $NEXT_PUBLIC_APP_URL/api/social/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta app for Instagram (Business/Creator account required, linked to a
# Facebook Page) — https://developers.facebook.com
# Redirect URI to register: $NEXT_PUBLIC_APP_URL/api/social/instagram/callback
META_APP_ID=
META_APP_SECRET=

# YouTube (PR5) — Google Cloud project with the YouTube Data API v3 enabled,
# OAuth 2.0 Client ID (Web application) — https://console.cloud.google.com
# Redirect URI to register: $NEXT_PUBLIC_APP_URL/api/social/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok (PR5) — TikTok for Developers app with Login Kit + Content Posting
# API — https://developers.tiktok.com
# Redirect URI to register: $NEXT_PUBLIC_APP_URL/api/social/tiktok/callback
# Unaudited apps can only post as SELF_ONLY (private, visible to the
# creator's own account) — see docs/master-plan.md §6 for the audit path.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Webhook ingestion (PR6). Reuses META_APP_ID/META_APP_SECRET already set
# above — signature verification (X-Hub-Signature-256) uses the same app
# secret. Set this to any random string; enter the same value as the
# "Verify Token" when subscribing this app's Webhooks product in the Meta
# App Dashboard. Without it, /api/webhooks/meta refuses every request
# (fails closed).
# Webhook URL to subscribe: $NEXT_PUBLIC_APP_URL/api/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=

# LINE Official Account, Messaging API (messaging concierge, Phase 1) —
# https://developers.line.biz/console/
# Long-lived channel access token (issued in the LINE Developers console under
# the channel's Messaging API tab). Server-only. Without it, connecting a LINE
# account and sending replies both refuse (fail closed).
LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret — verifies the X-Line-Signature header on incoming webhooks.
# Without it, /api/webhooks/line refuses every request (fails closed).
# Webhook URL to register in the console: $NEXT_PUBLIC_APP_URL/api/webhooks/line
LINE_CHANNEL_SECRET=

# Optional AI spend guardrail (PR9). USD ceiling per workspace per calendar
# month, checked against ai_generations.cost_usd before each real AI call.
# Unset means no cap (this is an opt-in ceiling, not a security boundary).
# Only meaningful once AI_INPUT_COST_PER_MTOK/AI_OUTPUT_COST_PER_MTOK are set
# above (cost stays 0, so a cap can never be reached, if those are unset).
# (ANTHROPIC_MONTHLY_BUDGET_USD still works as a fallback name.)
AI_MONTHLY_BUDGET_USD=

# External calendar sync (messaging concierge, Phase 4) — OPTIONAL, fail-closed.
# Each provider needs BOTH its vars set, or the calendar "同期" action reports
# that provider as unavailable (never a fake success). Set them to push an
# in-app calendar event into the external calendar.
#
# Notion — create an internal integration at https://www.notion.so/my-integrations,
# share the target database with it, and give the database a Title property "Name"
# and a Date property "Date" (optional rich_text "Location").
NOTION_INTEGRATION_TOKEN=
NOTION_CALENDAR_DATABASE_ID=
# TimeTree — register an application at https://developers.timetree.app/ and use
# the issued access token + the target calendar id.
TIMETREE_ACCESS_TOKEN=
TIMETREE_CALENDAR_ID=
