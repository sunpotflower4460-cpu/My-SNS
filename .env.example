# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here

# AI draft generation (PR2). Server-only — never expose this to the client.
# When unset, /api/drafts/generate falls back to deterministic templates and
# says so explicitly; it never pretends a template is an AI proposal.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-4-5-20251001 when unset.
ANTHROPIC_MODEL=
# Optional: USD per million tokens, used only to estimate ai_generations.cost_usd.
# Token counts are always recorded accurately even when these are left unset (cost stays 0).
ANTHROPIC_INPUT_COST_PER_MTOK=
ANTHROPIC_OUTPUT_COST_PER_MTOK=

# Publish Worker (PR3). Secures /api/publish/run, invoked on a schedule
# (see vercel.json). Vercel sets the Authorization header from this value
# automatically for its own Cron Jobs — see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
# Without this set, the Worker refuses every request (fails closed).
CRON_SECRET=
