    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
